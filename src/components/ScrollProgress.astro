---
/**
 * 顶部滚动进度条（机械卷尺效果）。
 * scroll 事件用 requestAnimationFrame 合并，同一帧多次触发只写一次 DOM，避免长页面抖动。
 * @author fxbin
 */
---

<div class="progress-tape" id="progress-tape"></div>

<style>
  .progress-tape {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--orange);
    width: 0%;
    z-index: 2000;
    box-shadow: 0 0 10px var(--glow-orange);
    transition: width 0.1s linear;
  }
</style>

<script>
  const tape = document.getElementById("progress-tape");
  if (tape) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const h = document.documentElement;
      const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
      tape.style.width = `${scrolled * 100}%`;
    };
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
