---
import ThemeToggle from "./ThemeToggle.tsx";

/**
 * 站点顶部导航栏。
 * 含 logo、主导航（总览 / 章节 / 番外）、版本信息与主题开关。
 * 窄屏下保留主导航与主题开关，仅隐藏版本信息文本。
 * @author fxbin
 */

/** 主导航链接项。路径与 astro.config.mjs 的 base 保持一致。 */
const NAV_ITEMS = [
  { label: "总览", href: "/pi-learn/overview/" },
  { label: "章节", href: "/pi-learn/" },
  { label: "番外", href: "/pi-learn/extras/" },
];
---

<header>
  <div class="container header-inner">
    <a href="/pi-learn/" class="logo">PI<span>-</span>LEARN</a>
    <nav class="main-nav" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="header-right">
      <span>DOCS v0.1.0</span>
      <span>BUILD: STABLE</span>
      <a
        class="repo-link"
        href="https://github.com/fxbin/pi-learn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 仓库（新窗口打开）"
      >GitHub ↗</a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1500;
    border-bottom: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    gap: 24px;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .logo span {
    color: var(--orange);
  }

  .main-nav {
    display: flex;
    gap: 24px;
    flex: 1;
    margin-left: 16px;
  }

  .main-nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .main-nav a:hover {
    color: var(--orange);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  /* GitHub 仓库外链：与主导航视觉一致，hover 转 orange */
  .repo-link {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .repo-link:hover {
    color: var(--orange);
  }

  :global(.theme-switch) {
    width: 48px;
    height: 24px;
    border: 1px solid var(--border);
    background: var(--surface);
    position: relative;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.theme-switch::after) {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background: var(--text);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.theme-switch.on) {
    border-color: var(--green);
  }

  :global(.theme-switch.on::after) {
    transform: translateX(24px);
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  @media (max-width: 640px) {
    .header-right span {
      display: none;
    }

    .main-nav {
      gap: 16px;
      margin-left: 8px;
    }
  }
</style>
