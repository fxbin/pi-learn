---
import { getCollection } from "astro:content";

/**
 * 章节页面左侧导航组件。
 * 列出所有章节，高亮当前章节，并显示当前章节的二级标题锚点。
 * @author fxbin
 */
interface Props {
  currentSlug: string;
  headings?: { slug: string; text: string; depth: number }[];
}

const { currentSlug, headings = [] } = Astro.props;
const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
const sectionHeadings = headings.filter((h) => h.depth === 2);
---

<aside class="chapter-nav" aria-label="章节导航">
  <nav class="nav-sections">
    <div class="nav-group">
      <div class="nav-label">章节</div>
      <ul class="chapter-list">
        {chapters.map((ch) => {
          const slug = ch.id.replace(/\.(md|mdx)$/, "");
          const isActive = slug === currentSlug;
          return (
            <li class={isActive ? "active" : ""}>
              <a href={`/pi-learn/chapters/${slug}/`} class={isActive ? "active" : ""}>
                <span class="chapter-num-small">{ch.data.num}</span>
                <span class="chapter-title-small">{ch.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    {sectionHeadings.length > 0 && (
      <div class="nav-group">
        <div class="nav-label">本章目录</div>
        <ul class="heading-list">
          {sectionHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </nav>
</aside>

<style>
  .chapter-nav {
    position: fixed;
    top: 64px;
    left: 0;
    bottom: 0;
    width: 260px;
    border-right: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    overflow-y: auto;
    padding: 32px 20px;
    z-index: 1200;
  }

  .nav-sections {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 12px;
    padding-left: 12px;
  }

  .chapter-list,
  .heading-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chapter-list a,
  .heading-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--text-dim);
    transition: all 0.2s ease;
    line-height: 1.4;
  }

  .chapter-list a:hover,
  .heading-list a:hover {
    background: var(--surface);
    color: var(--text);
  }

  .chapter-list li.active a {
    background: var(--surface);
    color: var(--orange);
    border-left: 2px solid var(--orange);
  }

  .chapter-num-small {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--orange);
    min-width: 28px;
  }

  .chapter-title-small {
    flex: 1;
  }

  .heading-list a {
    padding-left: 16px;
    border-left: 2px solid transparent;
  }

  .heading-list a:hover {
    border-left-color: var(--green);
    color: var(--green);
  }

  @media (max-width: 1100px) {
    .chapter-nav {
      display: none;
    }
  }
</style>
