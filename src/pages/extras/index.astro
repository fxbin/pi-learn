---
import Layout from "../../layouts/Layout.astro";

/**
 * 番外页面。
 * 正文章节之外的选读主题预览，每个主题给出问题、源码锚点、核心概念。
 * @author fxbin
 */
---

<Layout title="番外 · pi-learn" description="正文之外的选读主题">
  <article class="extras-page">
    <div class="extras-main">
      <div class="extras-meta">
        <div class="extras-num">EXTRAS</div>
        <h1>番外</h1>
        <p class="extras-description">
          正文章节之外的三个选读主题。每个主题独立成篇，不依赖正文顺序。
        </p>
      </div>

      <div class="extras-content">
        <section class="topic-card">
          <div class="topic-head">
            <span class="topic-tag">extensions</span>
            <h2>扩展系统</h2>
          </div>
          <p class="topic-question">
            agent 如何在运行时修改和扩展它自己——加载外部代码、注册工具、挂载生命周期钩子，而不重启进程？
          </p>
          <div class="topic-anchor">
            <span class="topic-label">源码锚点</span>
            <code>.pi/extensions/</code>
            <code>packages/coding-agent/examples/extensions/</code>
          </div>
          <div class="topic-concepts">
            <span class="topic-label">核心概念</span>
            <span class="concept-chip">ExtensionFactory</span>
            <span class="concept-chip">registerTool</span>
            <span class="concept-chip">onBeforeToolCall</span>
            <span class="concept-chip">onMessage</span>
            <span class="concept-chip">错误隔离边界</span>
          </div>
        </section>

        <section class="topic-card">
          <div class="topic-head">
            <span class="topic-tag">OAuth</span>
            <h2>订阅认证</h2>
          </div>
          <p class="topic-question">
            订阅制账号如何通过 device code 流程拿到访问令牌——无浏览器跳转、无本地端口、跨设备可用？
          </p>
          <div class="topic-anchor">
            <span class="topic-label">源码锚点</span>
            <code>packages/ai/src/auth/oauth/</code>
          </div>
          <div class="topic-concepts">
            <span class="topic-label">核心概念</span>
            <span class="concept-chip">device code</span>
            <span class="concept-chip">PKCE</span>
            <span class="concept-chip">token 刷新</span>
            <span class="concept-chip">凭证存储</span>
          </div>
        </section>

        <section class="topic-card">
          <div class="topic-head">
            <span class="topic-tag">TUI</span>
            <h2>终端界面</h2>
          </div>
          <p class="topic-question">
            终端界面如何消费 agent 的事件流——流式输出、工具调用可视化、中断反馈、多窗口布局，同时保持 60fps 响应？
          </p>
          <div class="topic-anchor">
            <span class="topic-label">源码锚点</span>
            <code>packages/tui/</code>
          </div>
          <div class="topic-concepts">
            <span class="topic-label">核心概念</span>
            <span class="concept-chip">事件订阅</span>
            <span class="concept-chip">Ink 渲染</span>
            <span class="concept-chip">焦点管理</span>
            <span class="concept-chip">输入模式</span>
          </div>
        </section>

        <p class="extras-back">
          ← <a href="/pi-learn/">返回首页</a>
        </p>
      </div>
    </div>
  </article>
</Layout>

<style>
  .extras-page {
    padding: 120px 0 80px;
    min-height: 100vh;
  }

  .extras-main {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .extras-meta {
    border-bottom: 1px solid var(--border);
    padding-bottom: 48px;
    margin-bottom: 48px;
  }

  .extras-num {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--orange);
    margin-bottom: 16px;
  }

  .extras-meta h1 {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 20px;
  }

  .extras-description {
    font-size: 18px;
    color: var(--text-dim);
    max-width: 720px;
    line-height: 1.6;
  }

  .extras-content {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text);
  }

  .topic-card {
    border: 1px solid var(--border);
    padding: 32px;
    margin-bottom: 32px;
    background: var(--card-bg, var(--bg));
    transition: border-color 0.2s ease;
  }

  .topic-card:hover {
    border-color: var(--orange);
  }

  .topic-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .topic-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--orange);
    border: 1px solid var(--orange);
    padding: 4px 10px;
    letter-spacing: 0.1em;
  }

  .topic-head h2 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text);
  }

  .topic-question {
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .topic-anchor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .topic-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-right: 4px;
  }

  .topic-anchor code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--surface);
    padding: 4px 10px;
    border: 1px solid var(--border);
    color: var(--green);
  }

  .topic-concepts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .concept-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--surface);
    padding: 4px 10px;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .extras-back {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .extras-back a {
    color: var(--orange);
    border-bottom: 1px solid var(--orange);
  }

  @media (max-width: 768px) {
    .extras-main {
      padding: 0 24px;
    }
    .topic-card {
      padding: 20px;
    }
  }
</style>
