---
import Layout from "../layouts/Layout.astro";
import ChapterCard from "../components/ChapterCard.astro";
import { getCollection } from "astro:content";

const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="pi-learn · 从零构建 agent harness">
  <section class="hero">
    <div class="container">
      <div class="hero-tag">// 面向 2030 的源码教学课程</div>
      <h1><span class="pi">PI</span> LEARN</h1>
      <p class="hero-sub">
        不依赖框架，不背诵 API。从 pi 的真实源码出发，
        逐章重建一个 agent harness 的完整机制。
      </p>
      <div class="hero-stats">
        <div class="stat"><strong>08</strong><span>核心章节</span></div>
        <div class="stat"><strong>01</strong><span>迷你 harness</span></div>
        <div class="stat"><strong>00</strong><span>构建工具</span></div>
      </div>
    </div>
  </section>

  <section class="dashboard">
    <div class="container">
      <div class="section-label">— 章节索引 / CHAPTER INDEX</div>
      <div class="chapter-grid">
        {chapters.map((ch) => (
          <ChapterCard
            num={ch.data.num}
            title={ch.data.title}
            description={ch.data.description}
            href={`/pi-learn/chapters/${ch.id}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <footer>
    <div class="container">pi-learn · 机械标本馆主题 · 2026</div>
  </footer>
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 64px;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
    border: 1px solid var(--green);
    display: inline-block;
    padding: 6px 12px;
    margin-bottom: 32px;
    width: fit-content;
  }

  .hero h1 {
    font-size: clamp(56px, 12vw, 160px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin-bottom: 32px;
  }

  .hero h1 .pi {
    color: var(--orange);
  }

  .hero-sub {
    font-size: clamp(18px, 2.5vw, 28px);
    color: var(--text-dim);
    max-width: 720px;
    line-height: 1.5;
    margin-bottom: 48px;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    font-family: var(--font-mono);
    font-size: 14px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }

  .stat strong {
    display: block;
    font-size: 32px;
    color: var(--text);
    margin-bottom: 4px;
  }

  .stat span {
    color: var(--text-dim);
  }

  .dashboard {
    padding: 120px 0;
    border-top: 1px solid var(--border);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 48px;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 48px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 48px;
    }
    .hero-stats {
      flex-direction: column;
      gap: 24px;
    }
    .chapter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
