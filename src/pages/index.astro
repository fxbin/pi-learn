---
import Layout from "../layouts/Layout.astro";
import ChapterCard from "../components/ChapterCard.astro";
import { getCollection } from "astro:content";

const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
const HOME_DESCRIPTION = "14 章逐章重建 agent harness：从 while 循环、工具调度、变更队列到会话树与流式输出";
---

<Layout title="pi-learn · 从零构建 agent harness" description={HOME_DESCRIPTION}>
  <section class="hero">
    <div class="container">
      <div class="hero-tag">// 面向 AI Agent 学习者</div>
      <h1><span class="pi">PI</span> LEARN</h1>
      <p class="hero-sub">
        不依赖框架，不背诵 API。从 pi 的真实源码出发，
        逐章重建一个 agent harness 的完整机制。
      </p>
      <div class="hero-stats">
        <div class="stat"><strong>14</strong><span>核心章节</span></div>
        <div class="stat"><strong>01</strong><span>迷你 harness</span></div>
        <div class="stat"><strong>03</strong><span>番外主题</span></div>
      </div>
    </div>
  </section>

  <section class="overview-banner">
    <div class="container">
      <a href="/pi-learn/overview/" class="overview-link">
        <span class="overview-link-label">总览</span>
        <span class="overview-link-title">pi 执行流程总览</span>
        <span class="overview-link-desc">14 个核心模块，按执行顺序动态串联。点击查看完整流程 →</span>
      </a>
    </div>
  </section>

  <section class="dashboard">
    <div class="container">
      <div class="section-label">— 章节索引 / CHAPTER INDEX</div>
      <div class="chapter-grid">
        {chapters.map((ch) => (
          <ChapterCard
            num={ch.data.num}
            title={ch.data.title}
            description={ch.data.description}
            href={`/pi-learn/chapters/${ch.id.replace(/\.(md|mdx)$/, "")}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="dashboard extras-section">
    <div class="container">
      <div class="section-label">— 番外 / EXTRAS</div>
      <div class="chapter-grid">
        <ChapterCard
          num="EX·01"
          title="扩展系统"
          description="运行时加载 TS 模块，注册工具/命令/provider/UI/快捷键，三层错误隔离。s10 机制内核的完整能力面。"
          href="/pi-learn/extras/extensions/"
        />
        <ChapterCard
          num="EX·02"
          title="订阅认证"
          description="device code 流程拿访问令牌——无浏览器跳转、无本地端口、跨设备可用的 OAuth 方案。"
          href="/pi-learn/extras/#oauth"
        />
        <ChapterCard
          num="EX·03"
          title="终端界面"
          description="消费 agent 事件流——流式输出、工具调用可视化、中断反馈、多窗口布局，保持 60fps。"
          href="/pi-learn/extras/#tui"
        />
      </div>
    </div>
  </section>

  <footer>
    <div class="container">pi-learn · 机械标本馆主题 · 2026</div>
  </footer>
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 64px;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
    border: 1px solid var(--green);
    display: inline-block;
    padding: 6px 12px;
    margin-bottom: 32px;
    width: fit-content;
  }

  .hero h1 {
    font-size: clamp(56px, 12vw, 160px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin-bottom: 32px;
  }

  .hero h1 .pi {
    color: var(--orange);
  }

  .hero-sub {
    font-size: clamp(18px, 2.5vw, 28px);
    color: var(--text-dim);
    max-width: 720px;
    line-height: 1.5;
    margin-bottom: 48px;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    font-family: var(--font-mono);
    font-size: 14px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }

  .stat strong {
    display: block;
    font-size: 32px;
    color: var(--text);
    margin-bottom: 4px;
  }

  .stat span {
    color: var(--text-dim);
  }

  .dashboard {
    padding: 120px 0;
    border-top: 1px solid var(--border);
  }

  /*
   * 总览入口 banner：hero 下方、章节索引上方。
   * 一个可点击的宽幅链接，引导读者先看总览再进章节。
   */
  .overview-banner {
    padding: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .overview-link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 24px 0;
    text-decoration: none;
    transition: all 0.2s ease;
    flex-wrap: wrap;
  }

  .overview-link:hover {
    padding-left: 12px;
  }

  .overview-link-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--orange);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .overview-link-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .overview-link-desc {
    font-size: 13px;
    color: var(--text-dim);
    margin-left: auto;
  }

  .extras-section {
    padding-top: 0;
    border-top: none;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 48px;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 48px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 48px;
    }
    .hero-stats {
      flex-direction: column;
      gap: 24px;
    }
    .chapter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
